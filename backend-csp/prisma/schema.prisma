generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== SUPER ADMIN ====================
model SuperAdmin {
  id                 String   @id @default(uuid())
  phone              String   @unique
  password           String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@map("super_admins")
}

// ==================== ÉCOLES ====================
model School {
  id                 String    @id @default(uuid())
  name               String
  phone              String    @unique
  password           String
  logo               String?
  slogan             String?
  address            String?
  email              String?
  primaryColor       String?
  secondaryColor     String?
  signature          String?
  subscriptionStatus String    @default("trial")
  trialDays          Int       @default(14)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  eleves        Eleve[]
  enseignants   Enseignant[]
  classes       Classe[]
  matieres      Matiere[]
  versements    Versement[]
  depenses      Depense[]
  examens       ExamenBlanc[]
  settings      SchoolSetting?
  inscriptions  Inscription[]
  schoolUsers   SchoolUser[]
  frais         FraisScolaire[]
  salaires      Salary[]
  academicYears AcademicYear[]
  horaires      HoraireEnseignant[]
  avances       AvanceSalaire[]
  notifications Notification[]
  parents       Parent[]
  absences      Absence[]
  annonces      Annonce[]
  affectations  Affectation[]
  messages      Message[]

  @@map("schools")
}

// ==================== ANNÉES SCOLAIRES ====================
model AcademicYear {
  id         String   @id @default(uuid())
  schoolId   String
  name       String
  isCurrent  Boolean  @default(false)
  isArchived Boolean  @default(false)
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@map("academic_years")
}

// ==================== ÉLÈVES ====================
model Eleve {
  id            String           @id @default(uuid())
  schoolId      String
  matricule     String           @unique
  nom           String
  prenom        String
  sexe          String
  dateNaissance DateTime
  lieuNaissance String
  nationalite   String
  telephone     String?
  photoUrl      String?
  nomParent     String
  adresseParent String
  telParent     String
  password      String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inscriptions  Inscription[]
  notes         Note[]
  examResults   ExamenResultat[]
  versements    Versement[]
  parents       ParentEleve[]
  absences      Absence[]

  @@unique([schoolId, matricule])
  @@map("eleves")
}

// ==================== ENSEIGNANTS (vacataires / permanents) ====================
model Enseignant {
  id           String              @id @default(uuid())
  schoolId     String
  nom          String
  prenom       String
  telephone    String
  email        String?
  specialite   String?
  estVacataire Boolean             @default(true) // true = payé à l'heure, false = salaire fixe
  tauxHoraire  Float? // pour vacataires (FCFA/heure)
  salaireFixe  Float? // pour permanents (FCFA/mois)
  anciennete   Int? // années d'ancienneté (sera calculé ou saisi)
  dateEmbauche DateTime?
  password     String? // mot de passe pour l'espace enseignant (bcrypt)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  salaires     Salary[]
  horaires     HoraireEnseignant[]
  avances      AvanceSalaire[]
  affectations Affectation[]

  @@unique([schoolId, telephone])
  @@index([schoolId])
  @@map("enseignants")
}

// ==================== CLASSES ====================
model Classe {
  id            String              @id @default(uuid())
  schoolId      String
  nom           String
  niveau        String
  capacite      Int?
  anneeScolaire String
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inscriptions  Inscription[]
  coefficients  Coefficient[]
  examens       ExamenBlanc[]
  frais         FraisScolaire[]
  horaires      HoraireEnseignant[]
  absences      Absence[]
  annonces      Annonce[]
  affectations  Affectation[]

  @@map("classes")
}

// ==================== MATIÈRES ====================
model Matiere {
  id           String              @id @default(uuid())
  schoolId     String
  libelle      String
  code         String?
  type         String?
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  coefficients Coefficient[]
  notes        Note[]
  examResults  ExamenResultat[]
  horaires     HoraireEnseignant[]
  absences     Absence[]
  affectations Affectation[]

  @@map("matieres")
}

// ==================== COEFFICIENTS ====================
model Coefficient {
  id            String  @id @default(uuid())
  schoolId      String
  classeId      String
  matiereId     String
  coefficient   Int
  anneeScolaire String
  classe        Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere       Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([classeId, matiereId, anneeScolaire])
  @@map("coefficients")
}

// ==================== INSCRIPTIONS ====================
model Inscription {
  id              String   @id @default(uuid())
  schoolId        String
  eleveId         String
  classeId        String
  anneeScolaire   String
  dateInscription DateTime @default(now())
  type            String
  reduction       Float?
  eleve           Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe          Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("inscriptions")
}

// ==================== NOTES ====================
model Note {
  id            String  @id @default(uuid())
  schoolId      String
  eleveId       String
  matiereId     String
  classeId      String
  semestre      Int
  anneeScolaire String
  devoir1       Float?
  devoir2       Float?
  composition   Float?
  moyenne       Float?
  rang          Int?
  appreciation  String?
  eleve         Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere       Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([eleveId, matiereId, semestre, anneeScolaire])
  @@map("notes")
}

// ==================== VERSEMENTS ====================
model Versement {
  id            String   @id @default(uuid())
  schoolId      String
  eleveId       String
  anneeScolaire String
  tranche       Int
  montant       Float
  reduction     Float?
  montantPaye   Float
  datePaiement  DateTime @default(now())
  modePaiement  String
  recuNumber    String
  commentaire   String?
  eleve         Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, recuNumber])
  @@index([schoolId])
  @@map("versements")
}

// ==================== DÉPENSES ====================
model Depense {
  id          String   @id @default(uuid())
  schoolId    String
  libelle     String
  montant     Float
  rubrique    String
  dateDepense DateTime @default(now())
  pieceJointe String?
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("depenses")
}

// ==================== EXAMENS BLANCS ====================
model ExamenBlanc {
  id            String           @id @default(uuid())
  schoolId      String
  nom           String
  dateDebut     DateTime
  dateFin       DateTime
  classeId      String
  anneeScolaire String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classe        Classe           @relation(fields: [classeId], references: [id], onDelete: Cascade)
  salles        ExamenSalle[]
  resultats     ExamenResultat[]

  @@map("examens_blancs")
}

model ExamenSalle {
  id       String      @id @default(uuid())
  examenId String
  nomSalle String
  capacite Int
  examen   ExamenBlanc @relation(fields: [examenId], references: [id], onDelete: Cascade)

  @@map("examens_salles")
}

model ExamenResultat {
  id        String      @id @default(uuid())
  examenId  String
  eleveId   String
  matiereId String
  note      Float
  rang      Int?
  examen    ExamenBlanc @relation(fields: [examenId], references: [id], onDelete: Cascade)
  eleve     Eleve       @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere   Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@map("examens_resultats")
}

// ==================== PARAMÈTRES ÉCOLE ====================
model SchoolSetting {
  id             String  @id @default(uuid())
  schoolId       String  @unique
  primaryColor   String? @default("#3B82F6")
  secondaryColor String? @default("#10B981")
  logoUrl        String?
  slogan         String?
  signature      String?
  address        String?
  email          String?
  phone          String?
  bulletinFormat String?
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

// ==================== UTILISATEURS DE L'ÉCOLE ====================
model SchoolUser {
  id        String   @id @default(uuid())
  schoolId  String
  login     String
  password  String
  role      String // Administrateur, Comptabilité, Info_Bulletin
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, login])
  @@map("school_users")
}

// ==================== FRAIS SCOLAIRES ====================
model FraisScolaire {
  id            String @id @default(uuid())
  schoolId      String
  classeId      String
  anneeScolaire String
  versement1    Float
  versement2    Float
  versement3    Float
  total         Float
  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classe        Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classeId, anneeScolaire])
  @@map("frais_scolaires")
}

// ==================== AVANCES SUR SALAIRE ====================
model AvanceSalaire {
  id           String     @id @default(uuid())
  schoolId     String
  enseignantId String
  montant      Float
  demandeDate  DateTime   @default(now())
  accordDate   DateTime?
  rembourse    Boolean    @default(false)
  remarque     String?
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  salaires     Salary[] // ← NOUVEAU

  @@map("avances_salaires")
}

// ==================== SALAIRES (avec type et référence à avance) ====================
model Salary {
  id              String         @id @default(uuid())
  schoolId        String
  enseignantId    String
  mois            Int
  annee           Int
  type            String         @default("normale") // "normale" ou "avance"
  avanceId        String? // référence à AvanceSalaire si type="avance"
  base            Float // salaire de base (heures * taux pour vacataire, salaireFixe pour permanent)
  primeAnciennete Float?
  vacation        Float? // heures supplémentaires (si applicable)
  total           Float
  isPaid          Boolean        @default(false)
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enseignant      Enseignant     @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  avance          AvanceSalaire? @relation(fields: [avanceId], references: [id])

  @@unique([schoolId, enseignantId, mois, annee, type])
  @@map("salaires")
}

// ==================== HORAIRES ENSEIGNANTS (VACATIONS) ====================
model HoraireEnseignant {
  id           String     @id @default(uuid())
  schoolId     String
  enseignantId String
  classeId     String
  matiereId    String
  jour         String // Lundi, Mardi, ...
  heureDebut   String // "08:00"
  heureFin     String // "09:00"
  mois         Int // 1-12
  annee        Int
  createdAt    DateTime   @default(now())
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe       Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere      Matiere    @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@map("horaires_enseignants")
}

// ==================== AFFECTATIONS ENSEIGNANT ↔ CLASSE ↔ MATIÈRE ====================
model Affectation {
  id           String     @id @default(uuid())
  schoolId     String
  enseignantId String
  classeId     String
  matiereId    String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe       Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere      Matiere    @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, classeId, matiereId])
  @@index([schoolId])
  @@map("affectations")
}

// ==================== PARENTS ====================
model Parent {
  id        String        @id @default(uuid())
  schoolId  String
  nom       String
  telephone String
  password  String
  email     String?
  adresse   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eleves    ParentEleve[]

  @@unique([schoolId, telephone])
  @@index([schoolId])
  @@map("parents")
}

// ==================== LIEN PARENT ↔ ÉLÈVE ====================
model ParentEleve {
  id       String @id @default(uuid())
  schoolId String
  parentId String
  eleveId  String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  eleve    Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([parentId, eleveId])
  @@index([eleveId])
  @@map("parent_eleves")
}

// ==================== ABSENCES & RETARDS ====================
model Absence {
  id                 String   @id @default(uuid())
  schoolId           String
  eleveId            String
  classeId           String
  matiereId          String?
  date               DateTime
  type               String // absence | retard
  motif              String?
  justifie           Boolean  @default(false)
  statutJustificatif String   @default("non_justifie") // non_justifie | en_attente | justifie
  enregistrePar      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eleve              Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe             Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere            Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  @@index([schoolId, date])
  @@index([eleveId, date])
  @@index([classeId, date])
  @@map("absences")
}

// ==================== ANNONCES ====================
model Annonce {
  id        String        @id @default(uuid())
  schoolId  String
  titre     String
  message   String
  type      String        @default("info") // info | urgence | evenement | resultat
  cible     String        @default("ecole") // ecole (tous) | parents (tous les parents) | classe (parents de la classe)
  classeId  String?
  date      DateTime      @default(now())
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classe    Classe?       @relation(fields: [classeId], references: [id], onDelete: SetNull)
  reads     AnnonceRead[]

  @@index([schoolId])
  @@map("annonces")
}

// ==================== LECTURE ANNONCES ====================
model AnnonceRead {
  id         String   @id @default(uuid())
  annonceId  String
  readerType String // parent | eleve | enseignant
  readerId   String
  readAt     DateTime @default(now())
  annonce    Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  @@unique([annonceId, readerType, readerId])
  @@map("annonce_reads")
}

// ==================== NOTIFICATIONS ====================
model Notification {
  id            String   @id @default(uuid())
  schoolId      String
  type          String // versement, eleve, bulletin, systeme, abonnement, absence, annonce
  title         String
  message       String
  isRead        Boolean  @default(false)
  link          String?
  recipientType String? // null = interne école ; parent | enseignant | eleve | ecole (broadcast)
  recipientId   String?
  createdAt     DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isRead])
  @@index([recipientType, recipientId])
  @@map("notifications")
}

// ==================== MESSAGERIE (école ↔ parents/élèves/enseignants) ====================
model Message {
  id              String   @id @default(uuid())
  schoolId        String
  conversationKey String // "parent:<id>" | "eleve:<id>" | "enseignant:<id>"
  senderType      String // ecole | parent | eleve | enseignant
  senderId        String? // null si école
  recipientType   String // ecole | parent | eleve | enseignant
  recipientId     String? // null si destinataire = école
  sujet           String
  contenu         String
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, conversationKey, createdAt])
  @@index([schoolId, isRead])
  @@map("messages")
}

// ==================== SESSIONS (refresh tokens révocables) ====================
model Session {
  id        String   @id @default(uuid())
  tokenId   String   @unique // jti du refresh token
  actorType String   // school | super_admin | parent | enseignant | eleve
  actorId   String
  schoolId  String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@index([revoked])
  @@map("sessions")
}

// ==================== JOURNAL D'AUDIT ====================
model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  actorType  String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([actorType, actorId])
  @@index([action])
  @@map("audit_logs")
}

// ==================== IDEMPOTENCY ====================
model IdempotencyKey {
  key      String   @id
  endpoint String
  method   String
  response Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}
